{
  "stylesheet": ".vscode/markdown.css",
  "pdf_options": {
    "format": "A4",
    "margin": {
      "top": "1cm",
      "right": "1cm",
      "bottom": "1cm",
      "left": "1cm"
    },
    "displayHeaderFooter": false,
    "timeout": 300000
  },
  "css": ".cover-page span[style*=\"font-size: 100px\"] { font-size: 36px !important; }",
  "launch_options": {
    "args": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-accelerated-2d-canvas",
      "--no-first-run",
      "--no-zygote",
      "--disable-gpu"
    ]
  }
}
